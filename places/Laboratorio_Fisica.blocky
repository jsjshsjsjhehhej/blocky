    {"name":"Head","size":[1.250,1.250,1.250],"color":[0.950,0.950,0.970]},
    {"name":"Left Arm","size":[1.000,2.000,1.000],"color":[0.950,0.950,0.970]},
    {"name":"Right Arm","size":[1.000,2.000,1.000],"color":[0.950,0.950,0.970]},
    {"name":"Left Leg","size":[1.000,2.000,1.000],"color":[0.220,0.720,0.320]},
